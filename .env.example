# -----------------------------------------------------------------------------
# En Compañía — Backend (Supabase CLI)
# Solo se necesita para trabajar contra el proyecto REMOTO.
# Para desarrollo local (`npm run db:start`) no hace falta completar nada.
# Copiá como `.env` y NUNCA lo subas al repositorio.
# -----------------------------------------------------------------------------

# Referencia del proyecto remoto (Dashboard > Project Settings > General).
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx

# Token personal para el CLI (Dashboard > Account > Access Tokens).
# Alternativa recomendada: `npx supabase login` (lo guarda en el llavero del sistema).
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contraseña de la base de datos remota (la pide `supabase link` / `db push`).
SUPABASE_DB_PASSWORD=cambiar-por-una-contraseña-segura
